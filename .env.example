DATABASE_URL=jdbc:postgresql://localhost:5433/email_platform
DATABASE_USERNAME=email_platform
DATABASE_PASSWORD=email_platform

POSTGRES_DB=email_platform
POSTGRES_USER=email_platform
POSTGRES_PASSWORD=email_platform
POSTGRES_HOST_PORT=5433

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=email_platform
RABBITMQ_PASSWORD=email_platform
RABBITMQ_DEFAULT_USER=email_platform
RABBITMQ_DEFAULT_PASS=email_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# Application send acceptance limit: messages per tenant per UTC minute. Enforced in Redis.
EMAIL_RATE_LIMIT_PER_MINUTE=120

MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025

# Local default remains Mailpit. Switch to Postfix only for controlled local MTA testing.
MTA_IMPLEMENTATION=mailpit
MTA_SMTP_HOST=localhost
MTA_SMTP_PORT=1025
MTA_SMTP_CONNECTION_TIMEOUT_MS=10000
MTA_SMTP_READ_TIMEOUT_MS=30000
MTA_SMTP_WRITE_TIMEOUT_MS=30000
MTA_SMTP_EHLO_HOSTNAME=texto.local
# Local Postfix uses plaintext SMTP. Do not enable trust-all certificates.
MTA_SMTP_STARTTLS_ENABLED=false
MTA_SMTP_STARTTLS_REQUIRED=false
MTA_SMTP_SSL_ENABLED=false
EMAIL_MAX_RFC822_BYTES=10485760
# For local Postfix instead of Mailpit:
# MTA_IMPLEMENTATION=postfix
# MTA_SMTP_HOST=localhost
# MTA_SMTP_PORT=2525

# Public Internet MX delivery. Must stay false locally.
# Production requires BOTH this flag and Postfix POSTFIX_ENABLE_PUBLIC_DELIVERY=yes
# with POSTFIX_PUBLIC_DELIVERY_CONFIRM=ENABLE_PUBLIC_MX_DELIVERY.
EMAIL_PUBLIC_DELIVERY_ENABLED=false
MTA_HOSTNAME=
MTA_OUTBOUND_IP=
BOUNCE_MX_HOSTNAME=
# SPF include _spf.texto.email is not provisioned. Set SPF_AUTHORIZE_OUTBOUND_IP=true
# only when MTA_OUTBOUND_IP is the real public sending address.
SPF_AUTHORIZE_OUTBOUND_IP=false
SPF_INCLUDE_PROVISIONED=false

# Postfix identity (compose). Production uses smtp.texto.email via env, not source.
POSTFIX_MYHOSTNAME=mail.texto.test
POSTFIX_MYDOMAIN=texto.test
POSTFIX_SMTP_HELO_NAME=mail.texto.test
POSTFIX_SMTPD_TLS_SECURITY_LEVEL=none
POSTFIX_SMTP_TLS_SECURITY_LEVEL=none
# Local compose hard-codes POSTFIX_ENABLE_PUBLIC_DELIVERY=no.

# Base64 32-byte AES key for DKIM private-key custody. Required in production.
# Generate: openssl rand -base64 32
DKIM_KEY_ENCRYPTION_KEY=

# Platform bounce envelope domain (not a public MX).
BOUNCE_DOMAIN=bounce.texto.test
POSTFIX_BOUNCE_DOMAIN=bounce.texto.test
# Public complaint/feedback-loop ingestion is not enabled.
COMPLAINT_MAX_PAYLOAD_BYTES=65536

CORS_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_PUBLIC=true
SERVER_PORT=8080

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

BILLING_PROVIDER=noop
BILLING_GRACE_PERIOD_DAYS=3
RAZORPAY_KEY_ID=rzp_live_SiRALpwdCfsmIC
RAZORPAY_KEY_SECRET=WYzwNvXkBIsST08pYZkhbdSk
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
