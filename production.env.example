# Production deployment placeholders. Copy to a secrets store / deployment env.
# Do not commit filled values. Do not enable public Internet delivery until the
# checklist in docs/production-smtp.md is actually complete.

# --- Application ---
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379

MTA_IMPLEMENTATION=ses
MTA_HOSTNAME=
MTA_SMTP_EHLO_HOSTNAME=
MTA_OUTBOUND_IP=
MTA_SMTP_HOST=
MTA_SMTP_PORT=587
MTA_SMTP_CONNECTION_TIMEOUT_MS=10000
MTA_SMTP_READ_TIMEOUT_MS=30000
MTA_SMTP_WRITE_TIMEOUT_MS=30000

SES_ENABLED=true
SES_REGION=ap-south-1
SES_CONFIGURATION_SET_NAME=my-first-configuration-set

# Application → Postfix TLS. Java uses the JVM default trust store and HTTPS
# endpoint identification. Do not use trust-all. Certificates live on the
# Postfix host, not in Git.
MTA_SMTP_STARTTLS_ENABLED=true
MTA_SMTP_STARTTLS_REQUIRED=true
MTA_SMTP_SSL_ENABLED=false

EMAIL_PUBLIC_DELIVERY_ENABLED=false
EMAIL_RATE_LIMIT_PER_MINUTE=120
EMAIL_MAX_RFC822_BYTES=10485760

BOUNCE_DOMAIN=
BOUNCE_MX_HOSTNAME=
DKIM_KEY_ENCRYPTION_KEY=
SPF_INCLUDE=_spf.texto.email
SPF_INCLUDE_PROVISIONED=false
SPF_AUTHORIZE_OUTBOUND_IP=false
DMARC_POLICY=none

CORS_ALLOWED_ORIGINS=

# --- Postfix (must match application identity) ---
POSTFIX_MYHOSTNAME=
POSTFIX_MYDOMAIN=
POSTFIX_MYORIGIN=
POSTFIX_SMTP_HELO_NAME=
POSTFIX_MYNETWORKS=
POSTFIX_SMTP_BIND_ADDRESS=
POSTFIX_BOUNCE_DOMAIN=

POSTFIX_SMTPD_TLS_SECURITY_LEVEL=encrypt
POSTFIX_SMTPD_TLS_CERT_FILE=/etc/postfix/certs/submission.crt
POSTFIX_SMTPD_TLS_KEY_FILE=/etc/postfix/certs/submission.key
POSTFIX_SMTP_TLS_SECURITY_LEVEL=may
POSTFIX_SMTP_TLS_CAFILE=/etc/ssl/certs/ca-certificates.crt

POSTFIX_ENABLE_PUBLIC_DELIVERY=no
# POSTFIX_PUBLIC_DELIVERY_CONFIRM=ENABLE_PUBLIC_MX_DELIVERY
