[Unit]
Description=Texto email API and delivery workers
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=texto
Group=texto
WorkingDirectory=/opt/texto-email/backend
EnvironmentFile=/etc/texto-email/backend.env
EnvironmentFile=-/etc/texto-email/aws.env
Environment=HOME=/var/lib/texto-email
Environment="JAVA_TOOL_OPTIONS=-Xms256m -Xmx1536m"
ExecStart=/usr/bin/java -jar /opt/texto-email/runtime/email-platform.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/texto-email

[Install]
WantedBy=multi-user.target
