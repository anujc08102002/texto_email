[Unit]
Description=Texto email website
Wants=network-online.target
After=network-online.target texto-email-backend.service

[Service]
Type=simple
User=texto
Group=texto
WorkingDirectory=/opt/texto-email/frontend
EnvironmentFile=/etc/texto-email/frontend.env
Environment=NODE_ENV=production
Environment="NODE_OPTIONS=--max-old-space-size=1024"
ExecStart=/usr/local/bin/node /opt/texto-email/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 13000
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/texto-email/frontend/.next

[Install]
WantedBy=multi-user.target
